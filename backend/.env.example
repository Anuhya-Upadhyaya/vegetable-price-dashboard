# Copy to .env and fill in your own private values.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Optional SMTP settings for customer-profile email alerts.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
ADMIN_NOTIFICATION_EMAIL=
